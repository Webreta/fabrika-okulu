# PostgreSQL (docker compose ile: postgres://fabo:fabo@localhost:5436/fabrika_okulu)
DATABASE_URL=postgres://fabo:fabo@localhost:5436/fabrika_okulu

# İlk admin (db:seed)
SEED_ADMIN_EMAIL=admin@fabrikaokulu.com.tr
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=degistir-beni

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# iyzico (sandbox: https://sandbox-api.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@uretmer.com.tr

# Cron endpoint'i koruyan gizli anahtar (/api/cron?key=...)
CRON_SECRET=degistir-beni
