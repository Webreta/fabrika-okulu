# PostgreSQL (docker compose ile: postgres://fabo:fabo@localhost:5436/fabrika_okulu)
DATABASE_URL=postgres://fabo:fabo@localhost:5436/fabrika_okulu

# İlk admin (db:seed)
SEED_ADMIN_EMAIL=admin@fabrikaokulu.com.tr
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=degistir-beni

# Canlıda yönetici hesabı (scripts/ensure-admin.mjs, her açılışta çalışır): hesap yoksa oluşturulur,
# varsa şifresine dokunulmaz. Şifreyi panelden değiştirdikten sonra ADMIN_PASSWORD kaldırılabilir.
# ADMIN_PASSWORD_RESET=1 → mevcut hesabın şifresini de ADMIN_PASSWORD yapar (kilitlenme durumunda; sonra kaldır)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Yönetici

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bakım modu (dışarıya gösterme). Boş = Yönetim → Ayarlar → Bakım modu'ndaki ayar geçerli.
# on  = ayar ne olursa olsun açık (canlıya ilk çıkışta siteyi kapalı başlatmak için)
# off = ayar ne olursa olsun kapalı (acil durum)
MAINTENANCE_MODE=

# iyzico (sandbox: https://sandbox-api.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# PayTR iFrame API (mağaza paneli → Bilgi; Bildirim URL: https://<site>/api/odeme/paytr). PAYTR_TEST_MODE=1 test, canlıda 0
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1https://sandbox-api.iyzipay.com

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@uretmer.com.tr

# Cron endpoint'i koruyan gizli anahtar (/api/cron?key=...)
CRON_SECRET=degistir-beni
