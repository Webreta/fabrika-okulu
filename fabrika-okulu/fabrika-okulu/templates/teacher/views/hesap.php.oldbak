<div class="oestp-account">
    <div class="oesp-section-title">Hesap detayları</div>

    <div class="oestp-card">
        <div class="oestp-account-head">
            <div class="oesp-avatar oesp-avatar-lg"><?php echo esc_html($u['initial']); ?></div>
            <div>
                <div class="oestp-account-name"><?php echo esc_html($u['name']); ?></div>
                <div class="oestp-account-mail"><i class="ti ti-mail"></i> <?php echo esc_html($u['email']); ?></div>
            </div>
        </div>

        <div class="oesp-auth-msg" id="oestpAccMsg" hidden></div>

        <form id="oestpAccountForm" class="oestp-form">
            <div class="oestp-form-row">
                <label>Ad
                    <input type="text" name="first_name" value="<?php echo esc_attr($u['first']); ?>" placeholder="Adın">
                </label>
                <label>Soyad
                    <input type="text" name="last_name" value="<?php echo esc_attr($u['last']); ?>" placeholder="Soyadın">
                </label>
            </div>

            <label>E-posta
                <input type="email" value="<?php echo esc_attr($u['email']); ?>" disabled>
                <small>E-posta adresi panelden değiştirilemez.</small>
            </label>

            <div class="oestp-form-divider"><span>Şifre değiştir (opsiyonel)</span></div>

